{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Professional Modern Invoice",
  "description": "Input contract for the Professional Modern Invoice template — a standalone, brand-forward A4 invoice. All amounts are integer cents. `logoUrl` is a remote image URL the server downloads at render time (Typst cannot fetch URLs itself); `logo` is set by the server and should not be supplied by the caller.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "businessName",
    "invoiceDate",
    "clientName",
    "items",
    "subtotalCents",
    "totalCents"
  ],
  "properties": {
    "businessName": { "type": "string" },
    "businessAddress": { "type": "array", "items": { "type": "string" } },
    "logoUrl": { "type": "string", "format": "uri" },
    "logoWidth": { "type": "number", "exclusiveMinimum": 0 },
    "invoiceTitle": { "type": "string" },
    "invoiceDate": { "type": "string" },
    "billToTitle": { "type": "string" },
    "clientName": { "type": "string" },
    "clientAddress": { "type": "array", "items": { "type": "string" } },
    "currencySymbol": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "quantity", "unitPriceCents"],
        "properties": {
          "name": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unitPriceCents": { "type": "integer" }
        }
      }
    },
    "note": { "type": "string" },
    "subtotalCents": { "type": "integer" },
    "discountRatePercent": { "type": ["number", "null"] },
    "discountCents": { "type": "integer" },
    "totalCents": { "type": "integer" },
    "thankYouMessage": { "type": "string" },
    "questionsEmail": { "type": "string" },
    "questionsPhone": { "type": "string" },
    "paymentAccount": { "type": "string" },
    "paymentName": { "type": "string" },
    "paymentBank": { "type": "string" },
    "terms": { "type": "string" }
  }
}
