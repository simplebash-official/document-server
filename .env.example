# ==============================================================================
# simplebash-pos: Document Server (Typst PDF Engine) Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure for local development or production:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. DATABASE & PERSISTENCE (SQLITE)
# ==============================================================================
# SQLite database file connection string (sqlx format).
# Relative paths resolve against the working directory the binary is executed from.
# The database file and document metadata tables are created automatically if missing.
DATABASE_URL=sqlite://document_server.db

# ==============================================================================
# 2. NETWORKING & HTTP SERVER
# ==============================================================================
# HTTP port the Axum server listens on.
# Set to 8090 to avoid collisions with the backend POS server (8080).
PORT=8090

# Address the HTTP listener binds to. Optional, defaults to 0.0.0.0 (all
# interfaces). Set to 127.0.0.1 to restrict the service to loopback only
# (used by the Tauri desktop bundle).
BIND_ADDR=0.0.0.0

# ==============================================================================
# 3. TYPST TEMPLATES & FONTS STORAGE
# ==============================================================================
# Filesystem directories scanned at startup for Typst template definitions and custom fonts.
# Can be absolute paths or relative to the working directory.
TEMPLATES_DIR=templates
FONTS_DIR=fonts

# ==============================================================================
# 4. PAYLOAD & MEMORY SAFETY LIMITS
# ==============================================================================
# Maximum allowed JSON request body size for POST /api/render/{templateKey}, in bytes.
# Default: 5242880 (5 MiB).
MAX_RENDER_BODY_BYTES=5242880

# ==============================================================================
# 5. REMOTE ASSET INGESTION (LOGO FETCHING)
# ==============================================================================
# Toggle whether the server downloads remote images (e.g., logoUrl in render requests).
# If set to false, logoUrl is ignored and templates fall back to their built-in defaults.
REMOTE_IMAGE_FETCH_ENABLED=true

# Maximum download size for remote image assets, in bytes. Default: 5242880 (5 MiB).
REMOTE_IMAGE_MAX_BYTES=5242880

# Request timeout for downloading remote images, in seconds. Default: 10.
REMOTE_IMAGE_TIMEOUT_SECS=10

# Allow logoUrl downloads from loopback / private / link-local addresses and
# follow redirects. Default: false (SSRF protection). Only set to true for
# local development against a logo server on your own machine or LAN.
ALLOW_PRIVATE_IP_IMAGES=false

# Deployment environment, shown by GET /api/health ("development" or "production").
APP_ENV=development

# ==============================================================================
# 6. SERVICE AUTHENTICATION & ACCESS CONTROL
# ==============================================================================
# Shared internal secret every caller must present as the 'X-Internal-Api-Key' header.
# Must match DOCUMENT_SERVER_API_KEY configured in the main backend POS service.
# REQUIRED: The server refuses to start if this is missing, shorter than 16
# characters, or still a placeholder. Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=replace_with_a_secure_random_64_character_hex_string

# ==============================================================================
# 7. LOGGING & TRACING
# ==============================================================================
# Tracing and log filter directive (tracing_subscriber EnvFilter syntax).
RUST_LOG=document_server=info,tower_http=info,info
