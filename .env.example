# SQLite database file (sqlx connection string). Relative paths resolve
# against the working directory the binary is run from. The file (and its
# two tables) is created automatically if it doesn't exist — no separate
# database service to install or run.
DATABASE_URL=sqlite://pdf_server.db

# HTTP port the server listens on.
PORT=8090

# Directories the render engine loads at startup — absolute or relative to
# the working directory the binary is run from.
TEMPLATES_DIR=templates
FONTS_DIR=fonts

# Optional: cap on request body size for POST /api/render/{templateKey}, in bytes.
MAX_RENDER_BODY_BYTES=5242880

# Standard tracing/log filter, same convention as jana2u-pos.
RUST_LOG=pdf_server=info,tower_http=info,info
