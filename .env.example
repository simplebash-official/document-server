# SQLite database file (sqlx connection string). Relative paths resolve
# against the working directory the binary is run from. The file (and its
# two tables) is created automatically if it doesn't exist — no separate
# database service to install or run.
DATABASE_URL=sqlite://document_server.db

# HTTP port the server listens on.
PORT=8090

# Directories the render engine loads at startup — absolute or relative to
# the working directory the binary is run from.
TEMPLATES_DIR=templates
FONTS_DIR=fonts

# Optional: cap on request body size for POST /api/render/{templateKey}, in bytes.
MAX_RENDER_BODY_BYTES=5242880

# Remote images: a render payload's `logoUrl` is downloaded at render time
# (Typst can't fetch a URL itself), used for that one compile, then dropped.
# REMOTE_IMAGE_FETCH_ENABLED=false ignores `logoUrl` entirely (templates fall
# back to their built-in default). MAX_BYTES / TIMEOUT_SECS bound each fetch.
REMOTE_IMAGE_FETCH_ENABLED=true
REMOTE_IMAGE_MAX_BYTES=5242880
REMOTE_IMAGE_TIMEOUT_SECS=10

# Standard tracing/log filter, same convention as jana2u-pos.
RUST_LOG=document_server=info,tower_http=info,info

# Shared secret every caller of POST /api/render/{key} and the /api/documents
# routes must present as the X-Internal-Api-Key header. jana2u-pos backend is
# the only intended caller — the frontend never talks to this service
# directly. No default: an unset key fails startup rather than booting open.
INTERNAL_API_KEY=change-me-in-production
