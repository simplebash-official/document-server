{
  "info": {
    "_postman_id": "0883660c-a4fe-456e-9da8-aa21dd56016c",
    "name": "document-server",
    "description": "Standalone Rust/Axum service that renders PDFs from Typst templates and generates standalone 1D barcodes and 2D QR codes. **No authentication** \u2014 every route here is open, so there is no Bearer/API-key setup needed.\n\nBase URL (and sample keys) are environment variables \u2014 switch the active Postman environment (Development/Production) to point requests at the right instance.\n\n**Modules**:\n- `Health`: Liveness probe (`/api/health`).\n- `Render`: PDF rendering endpoint (`/api/render/{templateKey}`) with dynamic barcode/QR placeholder support.\n- `Templates`: Template metadata listing and retrieval (`/api/templates`), categorized into `document` and `label` with `?type=document|label` filtering.\n- `Documents`: Document history and recompilation reprints (`/api/documents/{key}/pdf`).\n- `Barcodes`: Standalone 1D barcode generator (`/api/barcodes/generate`) supporting JSON and direct SVG streaming (Code128, Code39, EAN13, EAN8).\n- `QRCodes`: Standalone 2D QR code generator (`/api/qrcodes/generate`) supporting JSON and direct SVG streaming (ECC levels L, M, Q, H).\n\n**Getting real template keys**: run `Templates > List Templates` and copy the `key` values into `templateKey` (receipt document) or `stickerKey` (sticker label).\n\n**Getting a real document key**: run `Render > Render Receipt` once, then `Documents > List Documents` and copy a `key` into `documentKey`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Liveness check \u2014 always returns 200 if the process is up and able to handle a request at all. Doesn't touch SQLite or the render engine, so it can't distinguish \"server up, database down\"."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Render",
      "item": [
        {
          "name": "Render Module Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/render",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "render"
              ]
            },
            "description": "Trivial \"is this module wired up\" check \u2014 not a health/readiness probe."
          },
          "response": []
        },
        {
          "name": "Render Receipt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/render/{{templateKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "render",
                "{{templateKey}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceNumber\": \"INV-0001\",\n  \"customerName\": \"Jane Doe\",\n  \"items\": [\n    { \"description\": \"Widget\", \"quantity\": 2, \"unitPrice\": 9.99 },\n    { \"description\": \"Gadget\", \"quantity\": 1, \"unitPrice\": 19.99 }\n  ],\n  \"total\": 39.97,\n  \"footerCode\": {\n    \"type\": \"qr\",\n    \"value\": \"https://jana2u.com/pay/inv_0001\",\n    \"size\": \"18mm\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Compiles the `receipt` document template against this request body and returns the rendered PDF as raw bytes (`Content-Type: application/pdf`). Supports dynamic barcode or QR code injection via `footerCode` placeholder slot.\n\nErrors return standard `{success, message, code, statusCode}` JSON: 404 `TEMPLATE_NOT_FOUND`, 422 `RENDER_VALIDATION_FAILED`, 500 `PDF_EXPORT_FAILED`."
          },
          "response": []
        },
        {
          "name": "Render Sticker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/render/{{stickerKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "render",
                "{{stickerKey}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"USB-C Cable\",\n  \"reference\": \"SKU-00042\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Compiles the `sticker` label template (50mm\u00d730mm thermal label) with a Code128 barcode and QR code encoding `reference` via `templates/lib/codes.typ`. Returns raw PDF bytes on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "document",
                  "description": "Optional filter: 'document' or 'label'",
                  "disabled": true
                }
              ]
            },
            "description": "Lists template metadata (active and inactive), including category `type` (`document` or `label`), sorted by name. Supports optional `?type=document` or `?type=label` query filter."
          },
          "response": []
        },
        {
          "name": "List Document Templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates?type=document",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "document"
                }
              ]
            },
            "description": "Lists only document templates (`templates/documents/`)."
          },
          "response": []
        },
        {
          "name": "List Label Templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates?type=label",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "label"
                }
              ]
            },
            "description": "Lists only label templates (`templates/labels/`)."
          },
          "response": []
        },
        {
          "name": "Get Template",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates/{{templateKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates",
                "{{templateKey}}"
              ]
            },
            "description": "Fetch one template's metadata by `key` (including `name`, `type`, `description`, `data` expected payload sub-object, `isActive`). 404 `TEMPLATE_NOT_FOUND` if key doesn't exist."
          },
          "response": []
        },
        {
          "name": "Sync templates from disk",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}",
                "description": "Required \u2014 internal callers only."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/templates/sync",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "templates",
                "sync"
              ]
            },
            "description": "Runtime re-sync without a restart: rescans the templates directory, rebuilds the render engine, upserts metadata for every .typ found (including each template's dataSchema contract), and deactivates templates whose .typ file disappeared (rows are never deleted \u2014 keys are stable and history references them). Returns syncedCount, deactivatedCount and the template names now known."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents"
              ]
            },
            "description": "Lists every recorded document (written upon successful render), newest first. Use this to find a real `key` for `{{documentKey}}`."
          },
          "response": []
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{documentKey}}"
              ]
            },
            "description": "Fetch one document's metadata by `key` (templateKey, JSON data, and fileSizeBytes). 404 `DOCUMENT_NOT_FOUND` if the key doesn't exist."
          },
          "response": []
        },
        {
          "name": "Reprint Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentKey}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "documents",
                "{{documentKey}}",
                "pdf"
              ]
            },
            "description": "Recompiles this document's stored JSON `data` against its template and returns raw PDF bytes (`Content-Type: application/pdf`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Template Data",
      "item": [
        {
          "name": "Store shared data blob",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shopTradingName\": \"TechFix Repairs\",\n  \"shopLegalName\": \"TechFix Repairs (Pvt) Ltd\",\n  \"bankName\": \"Commercial Bank\",\n  \"accountNumber\": \"1234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/template-data/{{templateName}}/{{dataKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "template-data",
                "{{templateName}}",
                "{{dataKey}}"
              ]
            },
            "description": "Stores (or replaces) one shared/static JSON blob scoped to a template by name. The template must already exist. At render time every stored blob for that template is deep-merged under the request payload with request fields winning, so callers can omit genuinely static fields. Internal callers only."
          },
          "response": []
        },
        {
          "name": "Get one data blob",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/template-data/{{templateName}}/{{dataKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "template-data",
                "{{templateName}}",
                "{{dataKey}}"
              ]
            },
            "description": "Fetches one stored blob by (templateName, dataKey). Internal callers only."
          },
          "response": []
        },
        {
          "name": "List all blobs for a template",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/template-data/{{templateName}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "template-data",
                "{{templateName}}"
              ]
            },
            "description": "Lists every stored blob for the template. Internal callers only."
          },
          "response": []
        },
        {
          "name": "Delete one data blob",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/template-data/{{templateName}}/{{dataKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "template-data",
                "{{templateName}}",
                "{{dataKey}}"
              ]
            },
            "description": "Deletes one stored blob and echoes it back; 404 TEMPLATE_DATA_NOT_FOUND when absent. Internal callers only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Barcodes",
      "item": [
        {
          "name": "Barcodes Module Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/barcodes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barcodes"
              ]
            },
            "description": "Module status check for the Barcodes service."
          },
          "response": []
        },
        {
          "name": "Generate Barcode (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/barcodes/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barcodes",
                "generate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"INV-123456\",\n  \"symbology\": \"code128\",\n  \"height\": 80\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generates a 1D barcode and returns a JSON response containing SVG markup (`{ success: true, data: { content, symbology, svg } }`). Supported symbologies: `code128`, `code39`, `ean13`, `ean8`."
          },
          "response": []
        },
        {
          "name": "Generate Barcode (SVG Stream)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/barcodes/generate?content=INV-123456&symbology=code128&height=80",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "barcodes",
                "generate"
              ],
              "query": [
                {
                  "key": "content",
                  "value": "INV-123456",
                  "description": "Text payload to encode"
                },
                {
                  "key": "symbology",
                  "value": "code128",
                  "description": "code128 | code39 | ean13 | ean8 (default: code128)"
                },
                {
                  "key": "height",
                  "value": "80",
                  "description": "Barcode height in pixels (default: 80)"
                }
              ]
            },
            "description": "Generates a 1D barcode and streams the raw SVG directly with `Content-Type: image/svg+xml`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "QR Codes",
      "item": [
        {
          "name": "QR Codes Module Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/qrcodes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "qrcodes"
              ]
            },
            "description": "Module status check for the QR Codes service."
          },
          "response": []
        },
        {
          "name": "Generate QR Code (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qrcodes/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "qrcodes",
                "generate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"https://jana2u.com/pay/INV-123456\",\n  \"ecc\": \"M\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Generates a 2D QR code and returns a JSON response containing SVG markup (`{ success: true, data: { content, ecc, svg } }`). Supported ECC levels: `L`, `M`, `Q`, `H`."
          },
          "response": []
        },
        {
          "name": "Generate QR Code (SVG Stream)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/qrcodes/generate?content=https://jana2u.com/pay/INV-123456&ecc=M",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "qrcodes",
                "generate"
              ],
              "query": [
                {
                  "key": "content",
                  "value": "https://jana2u.com/pay/INV-123456",
                  "description": "Content or URL to encode in the QR code"
                },
                {
                  "key": "ecc",
                  "value": "M",
                  "description": "Error correction level: L | M | Q | H (default: M)"
                }
              ]
            },
            "description": "Generates a 2D QR code and streams the raw SVG directly with `Content-Type: image/svg+xml`."
          },
          "response": []
        }
      ]
    }
  ]
}